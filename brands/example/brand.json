      "bg": "#101418", "fg": "#F4F1EA", "accent": "#FF6B35", "muted": "#6B7480",
      "surface": "#161B21", "line": "#1E252D",
      "markBase": "#F4F1EA", "markAccent": "#FF6B35",
      "highlight": "color", "logo": "OnDark"
    },
    "light": {
      "bg": "#F4F1EA", "fg": "#101418", "accent": "#FF6B35", "muted": "#6B7480",
      "surface": "#E7E3D9", "line": "#D6D1C4",
      "markBase": "#101418", "markAccent": "#FF6B35",
      "highlight": "box", "logo": "OnLight"
    },
    "lime": {
      "bg": "#FF6B35", "fg": "#101418", "accent": "#101418", "muted": "#5A2A17",
      "surface": "#F25E2A", "line": "#E65520",
      "markBase": "#101418", "markAccent": "#101418",
      "highlight": "box", "logo": "MonoBlack"
    }
  },

  "fonts": {
    "arabic": {
      "family": "Cairo",
      "faces": [
        { "weight": 400, "file": "fonts/Cairo-Regular.ttf" },
        { "weight": 700, "file": "fonts/Cairo-Bold.ttf" }
