  "logo": {
    "mark": {
      "viewBox": [0, -48, 216, 191],
      "parts": [
        { "role": "base", "type": "polygon", "points": "0,0 58,-12 116,0 150,64 116,128 58,140 0,128" },
        { "role": "accent", "type": "polygon", "points": "70,70 100,40 130,70 100,100" },
        { "role": "pixel", "type": "rect", "x": 170, "y": -30, "w": 12 },
        { "role": "pixel", "type": "rect", "x": 184, "y": -44, "w": 12 },
        { "role": "pixel", "type": "rect", "x": 199, "y": -20, "w": 10 }
      ]
    },
    "wordmark": {
      "aspect": 10.6,
      "files": {
        "OnDark": "logo/Wordmark/Example-Wordmark-Color-OnDark.svg",
        "OnLight": "logo/Wordmark/Example-Wordmark-Color-OnLight.svg",
        "MonoBlack": "logo/Wordmark/Example-Wordmark-Mono-Black.svg"
      }
    },
    "lockupSources": {
      "horizontal": "logo/Horizontal/Example-Horizontal-Color-OnDark.svg",
      "horizontalNoTagline": "logo/Horizontal/Example-Horizontal-NoTagline-Color-OnDark.svg",
      "stacked": "logo/Stacked/Example-Stacked-Color-OnDark.svg"
    },
    "minMarkHeightPx": 24,
    "minHorizontalWidthPx": 120,
    "hideTaglineBelowWidthPx": 200
  },

  "contact": {
    "phone": "+000 000 0000",
    "instagram": "@example",
